# Copy to `.env` and adjust. `.env` must never be committed.
# Every value below is a local-development default; docker-compose.yml falls
# back to the same values when `.env` does not exist.

# --- API ---
APP_ENVIRONMENT=local

# --- PostgreSQL (synthetic data only) ---
POSTGRES_USER=asistente
POSTGRES_PASSWORD=asistente_local
POSTGRES_DB=asistente

# The API reads DATABASE_URL; docker-compose.yml builds it from the values above.
# Set it only to run the API outside Compose:
# DATABASE_URL=postgresql+psycopg://asistente:asistente_local@localhost:5432/asistente
# Integration tests read TEST_DATABASE_URL (a database whose name ends in `_test`);
# docker-compose.yml and the CI set it. Without it those tests are skipped.

# --- Host ports ---
API_PORT=8000
FRONTEND_PORT=8501
DB_PORT=5432
